local function ApplyNoCollisionToChar(char, disable)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if disable then
                if part.CanCollide then
                    part:SetAttribute("RadioCollideOrig", true)
                    part.CanCollide = false
                end
            else
                if part:GetAttribute("RadioCollideOrig") then
                    part.CanCollide = true
                    part:SetAttribute("RadioCollideOrig", nil)
                end
            end
        end
    end
end

