local function addWMElement(key, parent, iconId, textStr, isAccent, withSep)
    local label = createStatBlock(parent, iconId, textStr, isAccent)
    local block = label.Parent
    local sep = withSep and createSeparator(parent) or nil
    WatermarkElements[key] = {label = label, block = block, sep = sep}
    return label
end

