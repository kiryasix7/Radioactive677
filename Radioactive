local function ApplySkybox(id)
    ClearCustomSky()
    if not id or id == "" then return end
    local assetId = tostring(id):gsub("%s", "")
    if not assetId:match("^rbxassetid://") then
        local digits = assetId:gsub("%D", "")
        if digits == "" then return end
        assetId = "rbxassetid://" .. digits
    end
    local cam = workspace.CurrentCamera
    local folder = Instance.new("Folder")
    folder.Name = "RadioactiveSky"
    folder.Parent = cam
    customSkyFolder = folder
    local size = 2000
    local faceDefs = {
        {name = "Front", dir = Vector3.new(0, 0, -1), rot = CFrame.Angles(0, math.rad(180), 0)},
        {name = "Back",  dir = Vector3.new(0, 0, 1),  rot = CFrame.Angles(0, 0, 0)},
        {name = "Left",  dir = Vector3.new(-1, 0, 0), rot = CFrame.Angles(0, math.rad(90), 0)},
        {name = "Right", dir = Vector3.new(1, 0, 0),  rot = CFrame.Angles(0, math.rad(-90), 0)},
        {name = "Up",    dir = Vector3.new(0, 1, 0),  rot = CFrame.Angles(math.rad(90), 0, 0)},
        {name = "Down",  dir = Vector3.new(0, -1, 0), rot = CFrame.Angles(math.rad(-90), 0, 0)}
    }
    for _, def in ipairs(faceDefs) do
        local p = Instance.new("Part")
        p.Name = def.name
        p.Size = Vector3.new(size, size, 1)
        p.Anchored = true
        p.CanCollide = false
        p.CanQuery = false
        p.CanTouch = false
        p.CastShadow = false
        p.Transparency = 1
        p.Massless = true
        p.Parent = folder
        local d = Instance.new("Decal")
        d.Face = Enum.NormalId.Front
        d.Texture = assetId
        d.Parent = p
        table.insert(skyFacesData, {part = p, baseOffset = def.dir * (size / 2), rot = def.rot})
    end
end

