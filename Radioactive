RunService.RenderStepped:Connect(function(dt)
    if not getgenv().PredictAimEnabled then return end
    local cam = workspace.CurrentCamera
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    local vp = cam.ViewportSize
    local center = Vector2.new(vp.X/2, vp.Y/2)
    local fov = getgenv().PredictAimFOV or 200
    local hitpart = getgenv().PredictAimHitpart or "Head"

    local target = getgenv().PredictAimTarget
    if target then
        local tChar = target.Character
        local alive = false
        if tChar then
            local tHum = tChar:FindFirstChildOfClass("Humanoid")
            if tHum and tHum.Health > 0 then alive = true end
        end
        if not alive then
            getgenv().PredictAimTarget = nil
            target = nil
        end
    end

    if not target then
        local best, bestScore = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and not IsFriend(p) then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    if getgenv().PredictAimTeamCheck and p.Team == LocalPlayer.Team then continue end
                    local targetPart = hitpart == "Head" and p.Character:FindFirstChild("Head") or hrp
                    if not targetPart then continue end
                    local sp, on = cam:WorldToViewportPoint(targetPart.Position)
                    if on then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d < bestScore and d < fov then
                            if getgenv().PredictAimWallCheck then
                                local params = RaycastParams.new()
                                params.FilterType = Enum.RaycastFilterType.Exclude
                                params.FilterDescendantsInstances = {myChar, p.Character}
                                local hit = workspace:Raycast(cam.CFrame.Position, (targetPart.Position - cam.CFrame.Position).Unit * 1000, params)
                                if hit then continue end
                            end
                            bestScore = d
                            best = p
                        end
                    end
                end
            end
        end
        if best then getgenv().PredictAimTarget = best target = best end
    end
    if not target then
        AimBotInfoLabel.Text = "Auto Predict Time: — (no target)"
        return
    end

    local tChar = target.Character
    if not tChar then return end
    local tHRP = tChar:FindFirstChild("HumanoidRootPart")
    if not tHRP then return end
    local targetPart = hitpart == "Head" and tChar:FindFirstChild("Head") or tHRP
    if not targetPart then return end

    local aimPos
    if getgenv().PredictEnabled then
        local dist = (targetPart.Position - cam.CFrame.Position).Magnitude
        local bulletSpeed = getgenv().PredictAimBulletSpeed or 1500
        local ping = GetPing()
        local autoTime = (dist / bulletSpeed) + (ping / 2000)
        autoTime = math.clamp(autoTime, 0.02, 0.6)
        getgenv().PredictAimLastTime = autoTime

        AimBotInfoLabel.Text = string.format("Auto Predict Time: %.3fs  (dist %.0f studs, ping %d ms)", autoTime, dist, ping)

        local vel = tHRP.AssemblyLinearVelocity
        aimPos = targetPart.Position + vel * autoTime
    else
        AimBotInfoLabel.Text = "Predict: OFF — straight aim"
        aimPos = targetPart.Position
    end

    local smooth = getgenv().PredictAimSmooth or 1
    local curCF = cam.CFrame
    local targetCF = CFrame.new(curCF.Position, aimPos)
    if smooth <= 1 then
        cam.CFrame = targetCF
    else
        local alpha = math.clamp(dt * (1 / smooth) * 15, 0, 1)
        cam.CFrame = curCF:Lerp(targetCF, alpha)
    end
end)

