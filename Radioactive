-- PERSISTENT STATE
local FriendList = {}
local PointsList = {}
local PointIdCounter = 0

local function LoadData()
    pcall(function()
        if isfile("RadioactiveFriends.json") then
            FriendList = HttpService:JSONDecode(readfile("RadioactiveFriends.json"))
        end
    end)
    pcall(function()
        if isfile("RadioactivePoints.json") then
            local raw = HttpService:JSONDecode(readfile("RadioactivePoints.json"))
            for _, p in ipairs(raw) do
                PointIdCounter = PointIdCounter + 1
                PointsList[PointIdCounter] = {
                    id = PointIdCounter,
                    name = p.name,
                    pos = Vector3.new(p.x, p.y, p.z)
                }
            end
        end
    end)
end

local function SaveFriends()
    pcall(function() writefile("RadioactiveFriends.json", HttpService:JSONEncode(FriendList)) end)
end

local function SavePoints()
    local arr = {}
    for _, p in pairs(PointsList) do
        table.insert(arr, {name = p.name, x = p.pos.X, y = p.pos.Y, z = p.pos.Z})
    end
    pcall(function() writefile("RadioactivePoints.json", HttpService:JSONEncode(arr)) end)
end

local function IsFriend(player)
    return FriendList[string.lower(player.Name)] ~= nil
end

