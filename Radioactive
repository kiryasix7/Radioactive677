local CombatMain = CreateSection(CombatContent, "Aimbot")
getgenv().AimbotTarget = "Head"
CreateToggle(CombatMain, "Aimbot Enabled", false, function(state)
    getgenv().AimbotEnabled = state
    if state then
        getgenv().AimbotConnection = RunService.RenderStepped:Connect(function()
            local closest, shortest = nil, math.huge
            local mp = UserInputService:GetMouseLocation()
            local cam = workspace.CurrentCamera
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and not IsFriend(p) then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    local hum = p.Character:FindFirstChild("Humanoid")
                    if hrp and hum and hum.Health > 0 then
                        if getgenv().TeamCheck and p.Team == LocalPlayer.Team then continue end
                        local sp, on = cam:WorldToViewportPoint(hrp.Position)
                        if on then
                            local d = (Vector2.new(mp.X, mp.Y) - Vector2.new(sp.X, sp.Y)).Magnitude
                            if d < shortest and d < (getgenv().AimbotFOV or 150) then
                                if getgenv().WallCheck then
                                    local ray = Ray.new(cam.CFrame.Position, (hrp.Position - cam.CFrame.Position).Unit * 1000)
                                    local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, p.Character})
                                    if hit then continue end
                                end
                                shortest = d
                                closest = p
                            end
                        end
                    end
                end
            end
            if closest and closest.Character then
                local tp = getgenv().AimbotTarget == "Head" and closest.Character:FindFirstChild("Head") or closest.Character:FindFirstChild("HumanoidRootPart")
                if tp then cam.CFrame = CFrame.new(cam.CFrame.Position, tp.Position) end
            end
        end)
    else
        if getgenv().AimbotConnection then getgenv().AimbotConnection:Disconnect() end
    end
end)
