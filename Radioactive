local function BuildConfigString()
    local cfg = {
        version = 1,
        timestamp = os.time(),
        features = {},
        theme = {
            r = math.floor(Config.AccentColor.R * 255),
            g = math.floor(Config.AccentColor.G * 255),
            b = math.floor(Config.AccentColor.B * 255)
        },
        watermark = WatermarkState,
        friends = FriendList,
        points = {}
    }
    for _, k in ipairs(CONFIG_KEYS) do
        local v = getgenv()[k]
        if type(v) == "boolean" then
