    "StarsEnabled", "StarsRate", "StarsSize", "StarsFallSpeed",
    "FPSBoostEnabled", "AntiFlingEnabled", "ClickTPEnabled"
}

local function BuildConfigString()
    local cfg = {
        version = 6,
        timestamp = os.time(),
        features = {},
        theme = {r = math.floor(Config.AccentColor.R * 255), g = math.floor(Config.AccentColor.G * 255), b = math.floor(Config.AccentColor.B * 255)},
        watermark = {
            Visible = HUD_MainFrame.Visible,
            ShowName = WatermarkState.Name, ShowNickname = WatermarkState.Nickname,
            ShowFPS = WatermarkState.FPS, ShowPing = WatermarkState.Ping,
            ShowTPS = WatermarkState.TPS, ShowCoords = WatermarkState.Coords,
            ShowSpeed = WatermarkState.Speed
        },
        stars = {color = {
            r = math.floor((getgenv().StarsColor or Color3.fromRGB(255,255,255)).R * 255),
            g = math.floor((getgenv().StarsColor or Color3.fromRGB(255,255,255)).G * 255),
            b = math.floor((getgenv().StarsColor or Color3.fromRGB(255,255,255)).B * 255)
        }},
        friends = FriendList,
        points = {},
        keybinds = {}
    }
    for _, k in ipairs(CONFIG_KEYS) do
        local v = getgenv()[k]
        if type(v) == "boolean" then if v then cfg.features[k] = true end
        elseif type(v) == "number" or type(v) == "string" then cfg.features[k] = v end
    end
    for _, p in pairs(PointsList) do
        table.insert(cfg.points, {name = p.name, x = p.pos.X, y = p.pos.Y, z = p.pos.Z, visible = p.visible ~= false})
    end
    for id, data in pairs(KeybindData) do
        if data.key and data.name then cfg.keybinds[data.name] = data.key.Name end
    end
    return HttpService:JSONEncode(cfg)
end

