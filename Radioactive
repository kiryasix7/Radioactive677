local ThemeElements = {}
local function RegisterThemeElement(el, t, a)
    table.insert(ThemeElements, {element = el, type = t or "bg", isActiveOnly = a or false})
end
local function Tween(o, t, p, s, d)
    local info = TweenInfo.new(t or 0.25, s or Enum.EasingStyle.Quart, d or Enum.EasingDirection.Out)
    local tw = TweenService:Create(o, info, p); tw:Play(); return tw
end

local KeybindData = {}
local BindingTarget = nil
local RefreshKeybindsHUD = function() end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if BindingTarget then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            local data = KeybindData[BindingTarget]
            if data then
                if input.KeyCode == Enum.KeyCode.Escape then
                    if data.key then
                        data.label.Text = "[" .. data.key.Name .. "]"
                        data.label.TextColor3 = Color3.fromRGB(120,220,120)
                    else
                        data.label.Text = "[Bind]"
                        data.label.TextColor3 = Color3.fromRGB(160,160,160)
                    end
                else
                    data.key = input.KeyCode
                    data.label.Text = "[" .. input.KeyCode.Name .. "]"
                    data.label.TextColor3 = Color3.fromRGB(120,220,120)
                end
            end
            BindingTarget = nil
            RefreshKeybindsHUD()
        end
        return
    end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if UserInputService:GetFocusedTextBox() then return end
        for _, data in pairs(KeybindData) do
            if data.key and data.key == input.KeyCode then data.toggle() end
        end
    end
end)

local function NameToKey(name) if not name then return nil end return Enum.KeyCode[name] end

local FriendList = {}
local PointsList = {}
local PointIdCounter = 0

local function LoadData()
    pcall(function()
        if isfile("RadioactiveFriends.json") then
            local d = HttpService:JSONDecode(readfile("RadioactiveFriends.json"))
            if type(d) == "table" then FriendList = d end
        end
    end)
    pcall(function()
        if isfile("RadioactivePoints.json") then
            local raw = HttpService:JSONDecode(readfile("RadioactivePoints.json"))
            if type(raw) == "table" then
                for _, p in ipairs(raw) do
                    PointIdCounter = PointIdCounter + 1
                    PointsList[PointIdCounter] = {id = PointIdCounter, name = p.name, pos = Vector3.new(p.x, p.y, p.z), visible = true}
                end
            end
        end
    end)
end
local function SaveFriends() pcall(function() writefile("RadioactiveFriends.json", HttpService:JSONEncode(FriendList)) end) end
local function SavePoints()
    local arr = {}
    for _, p in pairs(PointsList) do table.insert(arr, {name = p.name, x = p.pos.X, y = p.pos.Y, z = p.pos.Z}) end
    pcall(function() writefile("RadioactivePoints.json", HttpService:JSONEncode(arr)) end)
end
local function IsFriend(player) return FriendList[string.lower(player.Name)] ~= nil end

