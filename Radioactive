    if UserInputService:IsKeyDown(Enum.KeyCode.S) then wishDir = wishDir - look end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then wishDir = wishDir - right end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then wishDir = wishDir + right end

    if wishDir.Magnitude < 0.01 then return end
    wishDir = wishDir.Unit

    local speed = getgenv().StrafeSpeed or 35
    local vel = hrp.AssemblyLinearVelocity
    hrp.AssemblyLinearVelocity = Vector3.new(wishDir.X * speed, vel.Y, wishDir.Z * speed)
end)

