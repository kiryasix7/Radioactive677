local function SpawnStar()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local center = char.HumanoidRootPart.Position
    local offset = Vector3.new(math.random(-200, 200), math.random(150, 300), math.random(-200, 200))
    local spawnPos = center + offset
    local star = Instance.new("Part")
    star.Shape = Enum.PartType.Ball
    star.Size = Vector3.new(getgenv().StarsSize or 1.5, getgenv().StarsSize or 1.5, getgenv().StarsSize or 1.5)
    star.Position = spawnPos
    star.Anchored = false
    star.CanCollide = false
    star.Material = Enum.Material.Neon
    star.Color = getgenv().StarsColor or Color3.fromRGB(255,255,255)
    star.Transparency = 0.1
    star.Parent = WorldStarsFolder
    local light = Instance.new("PointLight")
    light.Brightness = 3
    light.Range = 15
    light.Color = getgenv().StarsColor or Color3.fromRGB(255,255,255)
    light.Parent = star
    star.AssemblyLinearVelocity = Vector3.new(0, -(getgenv().StarsFallSpeed or 12), 0)
    star.Touched:Connect(function() star:Destroy() end)
    task.delay(30, function() if star and star.Parent then star:Destroy() end end)
end

