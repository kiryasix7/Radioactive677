local function ClearCustomSky()
    for _, d in ipairs(skyFacesData) do pcall(function() d.part:Destroy() end) end
    skyFacesData = {}
    if customSkyFolder then pcall(function() customSkyFolder:Destroy() end) customSkyFolder = nil end
