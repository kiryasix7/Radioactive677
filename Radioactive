local function CreateSlider(parent, textStr, minVal, maxVal, defaultVal, callback)
    local F = Instance.new("Frame")
    F.Size = UDim2.new(1, 0, 0, 40)
    F.BackgroundTransparency = 1
    F.Parent = parent
    local L = Instance.new("TextLabel")
    L.Size = UDim2.new(0.7, 0, 0, 20)
    L.BackgroundTransparency = 1
    L.Text = textStr
    L.TextColor3 = Config.TextColor
    L.Font = Config.Font
    L.TextSize = 14
    L.TextXAlignment = Enum.TextXAlignment.Left
    L.Parent = F
    local V = Instance.new("TextLabel")
    V.Size = UDim2.new(0.3, 0, 0, 20)
    V.Position = UDim2.new(0.7, 0, 0, 0)
    V.BackgroundTransparency = 1
    V.Text = tostring(defaultVal)
    V.TextColor3 = Config.TextDim
    V.Font = Config.Font
    V.TextSize = 14
    V.TextXAlignment = Enum.TextXAlignment.Right
    V.Parent = F
    local Bg = Instance.new("Frame")
    Bg.Size = UDim2.new(1, 0, 0, 6)
    Bg.Position = UDim2.new(0, 0, 0, 28)
    Bg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    Bg.Parent = F
    local BgC = Instance.new("UICorner") BgC.CornerRadius = UDim.new(1, 0) BgC.Parent = Bg
    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0)
    Fill.BackgroundColor3 = Config.AccentColor
    Fill.Parent = Bg
    RegisterThemeElement(Fill, "bg", false)
    local FC = Instance.new("UICorner") FC.CornerRadius = UDim.new(1, 0) FC.Parent = Fill
    local K = Instance.new("Frame")
    K.Size = UDim2.new(0, 14, 0, 14)
    K.Position = UDim2.new((defaultVal - minVal) / (maxVal - minVal), -7, 0.5, -7)
    K.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    K.Parent = Bg
    local KC = Instance.new("UICorner") KC.CornerRadius = UDim.new(1, 0) KC.Parent = K
    local dragging = false
    local barBtn = Instance.new("TextButton")
    barBtn.Size = UDim2.new(1, 0, 1, 20)
    barBtn.Position = UDim2.new(0, 0, 0, -7)
    barBtn.BackgroundTransparency = 1
    barBtn.Text = ""
    barBtn.Parent = Bg
    local function upd(input)
        local mx = input.Position.X
        local bx = Bg.AbsolutePosition.X
        local bw = Bg.AbsoluteSize.X
        local rx = math.clamp(mx - bx, 0, bw)
        local pct = rx / bw
        local val = math.floor(minVal + (maxVal - minVal) * pct)
        Fill.Size = UDim2.new(pct, 0, 1, 0)
        K.Position = UDim2.new(pct, -7, 0.5, -7)
        V.Text = tostring(val)
        if callback then callback(val) end
    end
    barBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true upd(input) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then upd(input) end
    end)
    return F
end

