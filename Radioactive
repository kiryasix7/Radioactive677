    distLbl.TextStrokeTransparency = 0
    distLbl.Font = Config.Font
    distLbl.TextSize = 12
    distLbl.Parent = bgFrame

    local spinConn = RunService.Heartbeat:Connect(function(dt)
        if top and top.Parent then
            top.CFrame = top.CFrame * CFrame.Angles(0, math.rad(120 * dt), 0)
