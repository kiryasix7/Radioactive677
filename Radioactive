RefreshKeybindsHUD = function()
    for _, c in ipairs(KBH_List:GetChildren()) do if c:IsA("TextLabel") then c:Destroy() end end
    for id, data in pairs(KeybindData) do data.hudLabel = nil end
    local count = 0
    for id, data in pairs(KeybindData) do
        if data.key and data.name then
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 0, 16)
            lbl.BackgroundTransparency = 1
            lbl.Text = "[" .. data.key.Name .. "]  " .. data.name
            lbl.TextColor3 = Config.BindOffColor
            lbl.Font = Config.Font
            lbl.TextSize = 12
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = KBH_List
            data.hudLabel = lbl
            count = count + 1
        end
    end
    if count == 0 then KeybindsHUD.Visible = false
    elseif getgenv().KeybindsHUDEnabled then KeybindsHUD.Visible = true end
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if getgenv().KeybindsHUDEnabled and KeybindsHUD.Visible then
            for _, data in pairs(KeybindData) do
                if data.hudLabel and data.hudLabel.Parent and data.getState then
                    local tc = data.getState() and Config.BindOnColor or Config.BindOffColor
                    if data.hudLabel.TextColor3 ~= tc then data.hudLabel.TextColor3 = tc end
                end
            end
        end
    end
end)

