-- TARGET HUD LOOP
local targetAccum = 0
local targetCurrentState = false

local function FadeTargetHUD(show)
    if show then
        TargetFrame.Visible = true
        Tween(TargetFrame, 0.35, {BackgroundTransparency = 0.15})
        Tween(TFS, 0.35, {Transparency = 0})
        Tween(TargetName, 0.3, {TextTransparency = 0})
        Tween(TargetHPBarBg, 0.3, {BackgroundTransparency = 0})
        Tween(TargetHPBar, 0.3, {BackgroundTransparency = 0})
        Tween(TargetHPText, 0.3, {TextTransparency = 0})
    else
        Tween(TargetFrame, 0.3, {BackgroundTransparency = 1})
        Tween(TFS, 0.3, {Transparency = 1})
        Tween(TargetName, 0.25, {TextTransparency = 1})
        Tween(TargetHPBarBg, 0.25, {BackgroundTransparency = 1})
        Tween(TargetHPBar, 0.25, {BackgroundTransparency = 1})
        Tween(TargetHPText, 0.25, {TextTransparency = 1})
        task.delay(0.3, function()
            if not targetCurrentState then TargetFrame.Visible = false end
        end)
    end
end

RunService.RenderStepped:Connect(function(dt)
    if not getgenv().TargetHUDEnabled then
        if targetCurrentState then
            targetCurrentState = false
            FadeTargetHUD(false)
        end
        return
    end
    targetAccum = targetAccum + dt
    if targetAccum < 0.05 then return end
    targetAccum = 0

    local cam = workspace.CurrentCamera
    local vp = cam.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local closest, closestDist = nil, math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local sp, on = cam:WorldToViewportPoint(p.Character.Head.Position)
            if on then
                local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if d < closestDist and d < 250 then
                    closestDist = d
                    closest = p
                end
            end
        end
    end

    local hasTarget = closest ~= nil
    if hasTarget ~= targetCurrentState then
        targetCurrentState = hasTarget
        FadeTargetHUD(hasTarget)
    end

    if closest then
        local hum = closest.Character.Humanoid
        TargetName.Text = closest.Name
        local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        Tween(TargetHPBar, 0.15, {Size = UDim2.new(pct, 0, 1, 0)})
        TargetHPText.Text = math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
    end
end)

-- MINIMAP LOOP
local minimapAccum = 0
RunService.RenderStepped:Connect(function(dt)
    if not MiniMapFrame.Visible then return end
    minimapAccum = minimapAccum + dt
    if minimapAccum < 0.03 then return end
    minimapAccum = 0
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local myPos = myChar.HumanoidRootPart.Position
    local area = MiniMapArea.AbsoluteSize
    local w, h = area.X, area.Y
    if w == 0 or h == 0 then return end
    local scale = w / (MINIMAP_RANGE * 2)
    local cam = workspace.CurrentCamera
    local lookV = cam.CFrame.LookVector
    local yaw = math.atan2(lookV.X, -lookV.Z)
    local rotDeg = -math.deg(yaw)
    MiniMapRotator.Rotation = rotDeg
    local rotRad = math.rad(rotDeg)
    local cosR, sinR = math.cos(rotRad), math.sin(rotRad)
    local baseX = math.floor(myPos.X / GRID_SPACING) * GRID_SPACING
    local baseZ = math.floor(myPos.Z / GRID_SPACING) * GRID_SPACING
    local lineIdx = 1
    local longSide = math.max(w, h) * 4
    for i = -7, 7 do
        local data = MiniMapGridLines[lineIdx]
        local worldX = baseX + i * GRID_SPACING
        local ux = (worldX - myPos.X) * scale
        data.frame.Size = UDim2.new(0, 1, 0, longSide)
        data.frame.Position = UDim2.new(0.5, ux, 0.5, 0)
        lineIdx = lineIdx + 1
    end
    for i = -7, 7 do
        local data = MiniMapGridLines[lineIdx]
        local worldZ = baseZ + i * GRID_SPACING
        local uy = (worldZ - myPos.Z) * scale
        data.frame.Size = UDim2.new(0, longSide, 0, 1)
        data.frame.Position = UDim2.new(0.5, 0, 0.5, uy)
        lineIdx = lineIdx + 1
    end
    local halfW = w / 2
    local halfH = h / 2
    local pad = 10
    local seen = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            seen[p] = true
            local rel = p.Character.HumanoidRootPart.Position - myPos
            local dist = math.sqrt(rel.X * rel.X + rel.Z * rel.Z)
            local ux, uy = rel.X * scale, rel.Z * scale
            local sx = ux * cosR - uy * sinR
            local sy = ux * sinR + uy * cosR
            local clampedX = math.clamp(sx, -halfW + pad, halfW - pad)
            local clampedY = math.clamp(sy, -halfH + pad, halfH - pad)
            local isOut = (sx ~= clampedX) or (sy ~= clampedY)
            local isFr = IsFriend(p)
            local dotData = MiniMapDots[p]
            if not dotData then
                local df = Instance.new("Frame")
                df.Size = UDim2.new(0, 8, 0, 8)
                df.BackgroundColor3 = isFr and Config.FriendColor or Color3.fromRGB(255, 60, 60)
                df.ZIndex = 6
                df.Parent = MiniMapArea
                local dc = Instance.new("UICorner") dc.CornerRadius = UDim.new(1, 0) dc.Parent = df
                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(0, 60, 0, 12)
                lbl.BackgroundTransparency = 1
                lbl.TextColor3 = Color3.fromRGB(255, 200, 200)
                lbl.Font = Config.Font
                lbl.TextSize = 10
                lbl.TextXAlignment = Enum.TextXAlignment.Center
                lbl.ZIndex = 7
                lbl.Text = ""
                lbl.Parent = MiniMapArea
                dotData = {frame = df, label = lbl}
                MiniMapDots[p] = dotData
            end
            dotData.frame.BackgroundColor3 = isFr and Config.FriendColor or Color3.fromRGB(255, 60, 60)
            dotData.frame.Position = UDim2.new(0.5, clampedX - 4, 0.5, clampedY - 4)
            if isOut then
                dotData.label.Visible = true
                dotData.label.Text = tostring(math.floor(dist))
                dotData.label.Position = UDim2.new(0.5, clampedX - 30, 0.5, clampedY + 6)
            else
                dotData.label.Visible = false
            end
        end
    end
    for p, data in pairs(MiniMapDots) do
        if not seen[p] then data.frame:Destroy() data.label:Destroy() MiniMapDots[p] = nil end
    end
    local seenPoints = {}
    for id, point in pairs(PointsList) do
        seenPoints[id] = true
        local rel = point.pos - myPos
        local ux, uy = rel.X * scale, rel.Z * scale
        local sx = ux * cosR - uy * sinR
        local sy = ux * sinR + uy * cosR
        local clampedX = math.clamp(sx, -halfW + pad, halfW - pad)
        local clampedY = math.clamp(sy, -halfH + pad, halfH - pad)
        local df = MiniMapPointDots[id]
        if not df then
            df = Instance.new("Frame")
            df.Size = UDim2.new(0, 8, 0, 8)
            df.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            df.ZIndex = 5
            df.Parent = MiniMapArea
            local dc = Instance.new("UICorner") dc.CornerRadius = UDim.new(1, 0) dc.Parent = df
            MiniMapPointDots[id] = df
        end
        df.Visible = point.visible ~= false
        df.Position = UDim2.new(0.5, clampedX - 4, 0.5, clampedY - 4)
    end
    for id, df in pairs(MiniMapPointDots) do
        if not seenPoints[id] then df:Destroy() MiniMapPointDots[id] = nil end
    end
end)

-- WORLD POINT DISTANCE UPDATE
RunService.RenderStepped:Connect(function()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local myPos = myChar.HumanoidRootPart.Position
    for id, point in pairs(PointsList) do
        local m = WorldMarkers[id]
        if m then m.distLbl.Text = tostring(math.floor((point.pos - myPos).Magnitude)) .. " studs" end
    end
end)

